# Public site identity is centralized in dist/site-config.js, not an environment override.
# Copy real credentials only through your secret manager; no credentials belong here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Retain existing production keys unless Clerk explicitly requires a domain-migration update.
# Vercel manages VERCEL_URL and VERCEL_ENV; do not set them manually.
